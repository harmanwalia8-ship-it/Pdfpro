<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: what Android's own backup and new-tablet transfer take of Margin's data.
-->
<data-extraction-rules>
    <!--
        Google's backup takes at most 25 MB per app and skips the app entirely above that.
        Leave out the untouched-original safety copies ("Restore original PDF"), which double
        the space of every PDF you write in; your library, notes, ink and PDFs are all included.
    -->
    <cloud-backup>
        <exclude domain="file" path="originals/" />
    </cloud-backup>
    <!-- Setting up a new tablet from the old one: no size limit, so everything comes along. -->
</data-extraction-rules>
